# Phase 0 uses disposable local-only values. Do not reuse these in production.
POSTGRES_DB=axit
POSTGRES_USER=axit
POSTGRES_PASSWORD=axit-phase0-only
PUBLIC_ORIGIN=http://localhost:3000
PUBLIC_HOST=localhost:3000
SESSION_COOKIE_SECURE=false
# Keep 127.0.0.1 by default. Use 0.0.0.0 only for an explicitly requested
# LAN test session together with matching PUBLIC_HOST and PUBLIC_ORIGIN values.
WEB_BIND_ADDRESS=127.0.0.1
# Repo-local, gitignored blob root shared by the API container and the
# host-side short-lived G0 extraction worker. Do not point this at web roots.
AXIT_BLOB_ROOT=./.axit-blobs
AXIT_G0_IMAGE=axit-ingestion-g0:local
# 승인된 설명 구체화 및 전체 보고서 파이프라인용. 상세 범위는 docs/provider-experiment-*.md 참고.
# 비워두면 설명 구체화는 비활성화되고 보고서 생성은 대체 결과 없이 재시도 가능 실패가 됩니다.
# 실제 키는 절대 커밋하지 마세요.
XAI_API_KEY=
GROK_MODEL=grok-4.5
